### 8. Get All Customers (No filters - default active)
# GET api/Customer/GetAllCustomers
# Protected by JWT Bearer Token
GET {{Billing_Software_Api_HostAddress}}/api/Customer/GetAllCustomers
Authorization: Bearer {{authToken}}
Accept: application/json

### 8a. Get All Customers (With Search & Filter Parameters)
# GET api/Customer/GetAllCustomers?search=9898989898&areaId=Deccan&cityId=Pune&stateId=Maharashtra&branchId=1&compId=1&isActive=true
GET {{Billing_Software_Api_HostAddress}}/api/Customer/GetAllCustomers?search=9898989898&areaId=Deccan&cityId=Pune&stateId=Maharashtra&branchId=1&compId=1&isActive=true
Authorization: Bearer {{authToken}}
Accept: application/json

### 9. Get Customer By ID
# GET api/Customer/GetCustomerById/{Cust_Id}
# Protected by JWT Bearer Token
GET {{Billing_Software_Api_HostAddress}}/api/Customer/GetCustomerById/1
Authorization: Bearer {{authToken}}
Accept: application/json

